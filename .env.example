# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FASTAPI_URL: Optional URL of a local Python FastAPI + PyTorch Geometric GNN backend
# (e.g. http://127.0.0.1:8000). When omitted, the Node/Express engine executes
# real Open-Meteo Marine ingestion and spatial graph advection directly.
FASTAPI_URL=""

# OPEN_METEO_MARINE_URL: Real-time oceanographic telemetry endpoint.
OPEN_METEO_MARINE_URL="https://marine-api.open-meteo.com/v1/marine"
